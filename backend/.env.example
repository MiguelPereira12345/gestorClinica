# Backend (Express) - exemplo de env
# Nota: no Render NÃO uses ficheiro .env. Configura estas variáveis no painel (Web Service -> Environment).

# Server
PORT=3001
NODE_ENV=development

# CORS (em DEV: Vite)
CORS_ORIGIN=http://localhost:5173

# Base URL pública do frontend (para links de recuperar palavra-passe)
FRONTEND_BASE_URL=http://localhost:5173
# Opcional: se quiseres forçar o URL completo da página de recuperação
# FRONTEND_RESET_URL=http://localhost:5173/recuperarpass

# Auth
# IMPORTANTE: gera um segredo longo (não commits)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_TTL_DAYS=30

# Database
# Preferido em produção/Render: usa DATABASE_URL (connection string do Postgres)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Alternativa suportada (compatibilidade): DB_URL
# DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Alternativa local (usada quando DATABASE_URL/DB_URL não está definido)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=BaseDadosFF
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# SSL (normalmente só interessa em produção)
# Em produção, se usares DATABASE_URL, o backend ativa SSL automaticamente.
# Se precisares de forçar:
# DB_SSL=true
# Se tiveres erro de certificado no Render, podes tentar:
# DB_SSL_REJECT_UNAUTHORIZED=false

# Email/SMTP (opcional - para enviar emails reais)
# MAIL_FROM=clinica@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=APP_PASSWORD
